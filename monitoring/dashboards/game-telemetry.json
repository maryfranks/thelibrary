          },
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 5,
        "title": "Hazard Deaths",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 15,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_deaths_total{death_type=\"environmental_hazard\"}[$__range])) or vector(0)",
            "legendFormat": "Hazard"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "orange"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 6,
        "title": "Unknown Deaths",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 18,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_deaths_total{death_type=\"unknown_death\"}[$__range])) or vector(0)",
            "legendFormat": "Unknown"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "purple"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 12,
        "title": "Disappearance Deaths",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 21,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_deaths_total{death_type=\"mysterious_disappearance\"}[$__range])) or vector(0)",
            "legendFormat": "Disappearance"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "blue"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 7,
        "title": "Deaths by Type (Share)",
        "type": "piechart",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum by (death_type) (increase(game_deaths_total[$__range]))",
            "legendFormat": "{{death_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "pieType": "donut",
          "tooltip": {
            "mode": "single"
          },
          "legend": {
            "showLegend": true,
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        }
      },
      {
        "id": 8,
        "title": "Deaths by Stage",
        "type": "barchart",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum by (stage) (increase(game_deaths_total[$__range]))",
            "legendFormat": "{{stage}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "unit": "short"
          }
        },
        "options": {
          "orientation": "auto",
          "showValue": "always",
          "groupWidth": 0.7
        }
      },
      {
        "id": 9,
        "title": "Run Outcomes Over Time (per min)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum by (outcome) (rate(game_runs_completed_total[$__rate_interval])) * 60",
            "legendFormat": "{{outcome}} / min"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 15
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 10,
        "title": "Deaths by Cause Over Time (per min)",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum by (death_type) (rate(game_deaths_total[$__rate_interval])) * 60",
            "legendFormat": "{{death_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 11,
        "title": "Deadliest Nodes (Top 10)",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "topk(10, sum by (node_id, stage) (increase(game_deaths_total[$__range])))",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": {
              "align": "auto"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Value"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Total Fatalities"
                }
              ]
            }
          ]
        },
        "options": {
          "sortBy": [
            {
              "displayName": "Total Fatalities",
              "desc": true
            }
          ]
        }
      }
    ],
    "schemaVersion": 39,
    "version": 5
  },
  "overwrite": true
}
