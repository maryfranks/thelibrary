{
  "dashboard": {
    "id": null,
    "uid": "littlefuzzydinos-game",
    "title": "LittleFuzzyDinos - Game Engine Telemetry",
    "tags": ["game", "thelibrary"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Total Wins",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_runs_completed_total{outcome=\"win\"}[$__range])) or vector(0)",
            "legendFormat": "Wins"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "green"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 2,
        "title": "Total Losses",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 4,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_runs_completed_total{outcome=\"loss\"}[$__range])) or vector(0)",
            "legendFormat": "Losses"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "semi-dark-red"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "value"
        }
      },
      {
        "id": 3,
        "title": "Total Deaths",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 4,
          "x": 8,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_deaths_total[$__range])) or vector(0)",
            "legendFormat": "Deaths"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "red"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "textMode": "auto",
          "colorMode": "background"
        }
      },
      {
        "id": 4,
        "title": "Monster Deaths",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 3,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "victoriametrics"
            },
            "expr": "sum(increase(game_deaths_total{death_type=\"monster_attack\"}[$__range])) or vector(0)",
            "legendFormat": "Monster"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "dark-red"
            },
            "unit": "none"
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
